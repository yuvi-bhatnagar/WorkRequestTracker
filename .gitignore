# ==============================================================================
# Flex — Comprehensive .gitignore
# Covers .NET Core, React/Vite, SQLite databases, OS & IDE artifacts
# ==============================================================================

# .NET Build Artifacts
**/bin/
**/obj/
**/Debug/
**/Release/
**/temp_check/
.vs/
.idea/
*.user
*.suo
*.userprefs
TestResults/
[Tt]est[Rr]esult*/

# Database Runtime Files
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
**/workrequests.db*
**/test_*.db*

# Frontend
**/node_modules/
**/dist/
dist-ssr/
*.local
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Logs & Caches
npm-debug.log*
yarn-debug.log*
.eslintcache
.vite/
.turbo/

# OS / Scratch
.DS_Store
Thumbs.db
[Dd]esktop.ini
scratch/
**/scratch/
*~
*.swp
